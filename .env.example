# Шаблон. Скопіюйте у файл .env і підставте реальні значення.
# Сам .env у репозиторій не потрапляє — його додано до .gitignore.

# Адреса проєкту Supabase "Rushh". Не секрет.
SUPABASE_URL=https://ljpaplkihpijuxgjfhex.supabase.co

# Публічний ключ (publishable / anon).
# Не секрет: призначений для браузера, обмежений правилами доступу.
# Береться в Supabase → Project Settings → API Keys → Publishable key
SUPABASE_ANON_KEY=

# СЕКРЕТНИЙ ключ (service_role).
# Обходить УСІ правила доступу — це фактично повний доступ до бази.
# Тільки для серверних скриптів. Ніколи не потрапляє у браузер, у фронтенд,
# у публічні логи чи в репозиторій.
# Береться в Supabase → Project Settings → API Keys → Secret keys
SUPABASE_SERVICE_ROLE_KEY=
